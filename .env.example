# Copiar a .env y completar. NUNCA subir el .env al repo.
NODE_ENV=development
PORT=9000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=printflow
DB_SSL=false

# Clave para firmar los JWT. Generar una propia: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=

# Origenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:5173

# Token compartido con n8n para el endpoint de ingesta (Fase 2 · Equipo C)
INGESTA_TOKEN=

# Solo para Docker Compose: puertos en TU PC. Cambiarlos si ya están ocupados
# (p. ej. por un PostgreSQL instalado en Windows o por otro proyecto).
DB_HOST_PORT=5433
WEB_PORT=8080
